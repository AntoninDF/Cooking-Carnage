<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" engine="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/Project/UI/UI_Style.uss?fileID=7433441132597879392&amp;guid=21ff664a8abdbee42b0ab74b63c70e6a&amp;type=3#UI_Style"/>
    <ui:VisualElement name="MainMenuRoot" style="position: absolute; width: 100%; height: 100%;">
        <ui:VisualElement name="Background" style="flex-grow: 1; position: absolute; background-image: url(&quot;project://database/Assets/Project/Art/UI/Menus/CookingCarnage_UI_MainMenuRougeFond.png?fileID=2800000&amp;guid=c95501cba3e6db542905e19e36e7d8e9&amp;type=3#CookingCarnage_UI_MainMenuRougeFond&quot;); top: 0; left: 0; right: 0; bottom: 0; display: flex; -unity-material: url(&quot;&quot;);"/>
        <ui:VisualElement name="MainPanel" style="position: absolute; width: 100%; height: 100%; display: flex;">
            <ui:VisualElement name="MainMenuBackground" style="position: absolute; width: 100%; height: 100%;">
                <ui:VisualElement name="MainBackground" style="flex-grow: 1; position: absolute; top: 0; right: 0; bottom: 0; left: 0; background-image: url(&quot;project://database/Assets/Project/Art/UI/Menus/MENU_DEMARRAGE/CookingCarnage_MenuDemarrage_Fond.png?fileID=2800000&amp;guid=9ad57746022f2ca48ae03a416771d2d2&amp;type=3#CookingCarnage_MenuDemarrage_Fond&quot;);"/>
            </ui:VisualElement>
            <ui:VisualElement name="GameTitle" style="flex-grow: 1; background-image: url(&quot;project://database/Assets/Project/Art/UI/Menus/MENU_DEMARRAGE/CookingCarnage_MenuDemarrage_Titre.png?fileID=2800000&amp;guid=6acadfe622d27354f8e8e2156687fdad&amp;type=3#CookingCarnage_MenuDemarrage_Titre&quot;); -unity-background-scale-mode: scale-to-fit; position: absolute; top: 0%; left: 2%; right: 40%; bottom: 32%;"/>
            <ui:VisualElement name="ShiftNumberContainer" style="position: absolute; top: 77%; right: 34%; height: auto; width: auto; rotate: -5deg; flex-direction: row;">
                <ui:Label text="SHIFT N.  " name="ShiftText" class="shift-info-text" style="position: relative; -unity-text-align: middle-left;"/>
                <ui:Label name="ShiftNumberText" data-source="" class="shift-info-text" style="position: relative; align-items: auto; justify-content: flex-start; align-content: flex-start; align-self: flex-start; -unity-text-align: middle-left; font-size: 70px; white-space: pre;"/>
            </ui:VisualElement>
            <ui:VisualElement name="ButtonContainer" style="justify-content: center; align-items: auto; position: absolute; top: 65%; left: 19%; rotate: -10deg; align-self: center; bottom: 7%; flex-direction: column;">
                <ui:Button name="BtnPlay" text="PLAY" class="main-menu-btn" style="-unity-text-align: middle-right;"/>
                <ui:Button name="BtnSettings" text="SETTINGS" class="main-menu-btn"/>
                <ui:Button name="BtnCredits" text="CREDITS" class="main-menu-btn"/>
                <ui:Button name="BtnQuit" text="QUIT" class="main-menu-btn"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="CreditsPanel" style="position: absolute; width: 100%; height: 100%; display: none;">
            <ui:VisualElement name="CreditsBackgroundStickers" style="position: absolute; width: 100%; height: 100%; background-image: url(&quot;project://database/Assets/Project/Art/UI/Menus/CREDITS/CookingCarnage_CreditsStickers.png?fileID=2800000&amp;guid=5b69f0993e4955744aa70eb15a25d4cb&amp;type=3#CookingCarnage_CreditsStickers&quot;);"/>
            <ui:VisualElement name="CreditsBackgroundLayout" style="position: absolute; width: 100%; height: 100%; background-image: url(&quot;project://database/Assets/Project/Art/UI/Menus/CREDITS/CookingCarnage_CreditsCadre.png?fileID=2800000&amp;guid=78b76101d9b23a648a2d74c4c741c68b&amp;type=3#CookingCarnage_CreditsCadre&quot;);"/>
            <ui:VisualElement name="GameTitle" style="flex-grow: 1; background-image: url(&quot;project://database/Assets/Project/Art/UI/Menus/CREDITS/CookingCarnage_Credits.png?fileID=2800000&amp;guid=7281eb873b2801543afb61534342dc32&amp;type=3#CookingCarnage_Credits&quot;); -unity-background-scale-mode: scale-to-fit; width: auto; height: auto;"/>
            <ui:Button name="BtnCreditsBack" text="&#10;" style="position: absolute; bottom: 5%; align-self: center; background-image: url(&quot;project://database/Assets/Project/Art/UI/Menus/MENU_SHIFTRECAP/CookingCarnage_BoutonBackON.png?fileID=2800000&amp;guid=71da140d66661a5499cc483c7f585026&amp;type=3#CookingCarnage_BoutonBackON&quot;); background-size: contain; width: 160px; background-color: rgba(188, 188, 188, 0); height: 40px; left: 0;"/>
        </ui:VisualElement>
        <ui:VisualElement name="SplashscreenPanel" style="flex-grow: 1; display: none; position: absolute; top: 0; left: 0; bottom: 0; right: 0; background-size: cover; background-image: none;"/>
    </ui:VisualElement>
</ui:UXML>
