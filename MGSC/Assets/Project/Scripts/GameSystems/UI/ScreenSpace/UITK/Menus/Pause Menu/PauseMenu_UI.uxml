<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" engine="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/Project/Scripts/GameSystems/UI/ScreenSpace/StyleSheets/UI_Style.uss?fileID=7433441132597879392&amp;guid=21ff664a8abdbee42b0ab74b63c70e6a&amp;type=3#UI_Style"/>
    <ui:VisualElement name="PauseMenuRoot" style="position: absolute; width: 100%; height: 100%;">
        <ui:VisualElement name="Background" style="flex-grow: 1; position: absolute; background-image: none; top: 0; left: 0; right: 0; bottom: 0; display: flex; -unity-material: url(&quot;&quot;); opacity: 0.91; background-color: rgb(0, 0, 0);"/>
        <ui:VisualElement name="MainPanel" style="position: absolute; width: 100%; height: 100%; display: flex;">
            <ui:Image source="project://database/Assets/Project/Art/UI/Menus/MENU_PAUSE/CookingCarnage_MenuPause_Pause.png?fileID=2800000&amp;guid=f204dc01876c1704e8588bcae65ad64e&amp;type=3#CookingCarnage_MenuPause_Pause" name="PauseIcon" style="top: -4%; bottom: auto; align-items: center; width: 90%; height: 80%; align-self: center; left: auto; right: auto;"/>
            <ui:VisualElement name="ButtonContainer_text" style="justify-content: center; align-items: center; position: absolute; top: 63%; left: auto; align-self: center; bottom: 55px; flex-direction: column; right: auto; align-content: flex-start; height: auto; width: 50%; display: none;">
                <ui:Button name="BtnPlay" text="RESUME" class="pause-menu-btn"/>
                <ui:Button name="BtnSettings" text="MAIN MENU" class="pause-menu-btn" style="top: 10%; bottom: 0%;"/>
                <ui:Button name="BtnQuit" text="QUIT" class="pause-menu-btn" style="top: 20%;"/>
            </ui:VisualElement>
            <ui:VisualElement name="ButtonContainer_image" style="justify-content: center; align-items: center; position: absolute; top: 68%; left: auto; align-self: center; bottom: auto; flex-direction: column; right: auto; align-content: flex-start; height: 25%; width: 400px; display: flex;">
                <ui:Button name="BtnPlay" icon-image="project://database/Assets/Project/Art/UI/Menus/MENU_PAUSE/CookingCarnage_MenuPause_ResumeOFF.png?fileID=2800000&amp;guid=6f7899c8e9e597f4794933384b517828&amp;type=3#CookingCarnage_MenuPause_ResumeOFF" class="pause-menu-btn" style="width: 80%; height: 40%;"/>
                <ui:Button name="BtnSettings" icon-image="project://database/Assets/Project/Art/UI/Menus/MENU_PAUSE/CookingCarnage_MenuPause_MainMenuOFF.png?fileID=2800000&amp;guid=cb5596c48ba854c48ad35ed22e60957c&amp;type=3#CookingCarnage_MenuPause_MainMenuOFF" class="pause-menu-btn" style="width: 80%; height: 40%;"/>
                <ui:Button name="BtnQuit" icon-image="project://database/Assets/Project/Art/UI/Menus/MENU_PAUSE/CookingCarnage_MenuPauseQuitOFF.png?fileID=2800000&amp;guid=1bb47dc6050d38948bf06ec5aeed9f1e&amp;type=3#CookingCarnage_MenuPauseQuitOFF" class="pause-menu-btn" style="width: 80%; height: 40%;"/>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
