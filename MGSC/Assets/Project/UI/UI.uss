:root {
}

.MainMenuText {
    -unity-font-definition: url("project://database/Assets/Project/Art/UI/Fonts/allegro/allegro.ttf?fileID=12800000&guid=f1ec3ccc8eb48954cbf95ec695dba501&type=3#allegro");
    -unity-text-align: lower-center;
    text-overflow: ellipsis;
    white-space: normal;
    font-size: 25px;
    margin-top: 13px;
    padding-bottom: 0;
    padding-top: 0;
    letter-spacing: 5px;
}

.MainMenuButtons {
    background-color: rgba(188, 188, 188, 0);
    -unity-text-align: lower-center;
    margin-top: 2px;
    margin-right: 0;
    margin-bottom: 2px;
    margin-left: 0;
    padding-top: 10px;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    text-overflow: ellipsis;
    height: 35px;
    justify-content: space-evenly;
    align-self: auto;
    align-content: center;
    align-items: center;
}
