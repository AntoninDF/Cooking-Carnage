        Data3: -1117725539
        Data4: -98236465
      Path: event:/Tutorial/Slush/Voiceline_Slush_11
    SubtitleText: Customers may ask for juice in addition to their meal, you'll just
      have to serve it to them.
    ActionsAfterDialogue:
      LockFeatures: 0
      UnlockFeatures: 0
      DisplayArrows: 0
      RaiseEvent: {fileID: 0}
