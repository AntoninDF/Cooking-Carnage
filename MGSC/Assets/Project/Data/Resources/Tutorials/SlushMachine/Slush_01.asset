        Data4: -587606713
      Path: event:/Tutorial/Slush/Voiceline_Slush_04
    SubtitleText: Sooo, you wanted to grow, didn't ya?
    ActionsAfterDialogue:
      LockFeatures: 0
      UnlockFeatures: 0
      DisplayArrows: 0
      RaiseEvent: {fileID: 0}
      AddTasks: []
    DelayBeforeNextSubStep: 0.5
