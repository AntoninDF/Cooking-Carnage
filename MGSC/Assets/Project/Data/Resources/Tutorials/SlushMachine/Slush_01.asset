        Data2: 1202318924
        Data3: -1619218795
        Data4: -516933304
      Path: event:/Tutorial/Slush/Voiceline_Slush_08
    SubtitleText: Yeah, I know, I know. It's pretty cool, isn't it?
    ActionsAfterDialogue:
      LockFeatures: 0
      UnlockFeatures: 0
      DisplayArrows: 0
      RaiseEvent: {fileID: 0}
      AddTasks: []
    DelayBeforeNextSubStep: 0.5
  - ActionsBeforeDialogue:
