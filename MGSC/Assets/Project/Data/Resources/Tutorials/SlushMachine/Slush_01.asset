        Data2: 1075132420
        Data3: -1035163227
        Data4: -400910054
      Path: event:/Tutorial/Slush/Voiceline_Slush_10
    SubtitleText: Anyways, that juice is sucked up and transferred directly into
      your juice machine, which is somewhere on your work station.
    ActionsAfterDialogue:
      LockFeatures: 0
      UnlockFeatures: 0
      DisplayArrows: 256
      RaiseEvent: {fileID: 0}
      AddTasks: []
    DelayBeforeNextSubStep: 1.5
