        Data1: -499171304
        Data2: 1129792550
        Data3: 632275072
        Data4: -1771056484
      Path: event:/Tutorial/Slush/Voiceline_Slush_07
    SubtitleText: Alright. It's pretty easy. When you transform a customer into ingredients,
      you also collect customer juice!
    ActionsAfterDialogue:
      LockFeatures: 0
      UnlockFeatures: 0
      DisplayArrows: 0
      RaiseEvent: {fileID: 0}
      AddTasks: []
    DelayBeforeNextSubStep: 1
