        Data3: -634224721
        Data4: 390927033
      Path: event:/Tutorial/Slush/Voiceline_Slush_06
    SubtitleText: So, hum... The juice machine. Let's see what the manual has to
      say.
    ActionsAfterDialogue:
      LockFeatures: 0
      UnlockFeatures: 0
      DisplayArrows: 0
      RaiseEvent: {fileID: 0}
      AddTasks: []
    DelayBeforeNextSubStep: 1.5
  - ActionsBeforeDialogue:
      LockFeatures: 0
      UnlockFeatures: 0
      DisplayArrows: 0
      RaiseEvent: {fileID: 0}
      AddTasks: []
    VoiceLine:
